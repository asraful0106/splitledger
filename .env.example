# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_WEB_URL=http://localhost:5173

# --- Database ---
POSTGRES_USER=splitledger
POSTGRES_PASSWORD=splitledger
POSTGRES_DB=splitledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://splitledger:splitledger@localhost:5432/splitledger

# --- Auth (use long random values) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=sl_refresh
EMAIL_VERIFY_TTL=24h
PASSWORD_RESET_TTL=30m
MAX_TRANSACTION_MINOR=1000000000

# --- Email (SMTP; Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SplitLedger <no-reply@splitledger.local>
