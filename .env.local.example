# Environment for the local stack (docker-compose.local.yml).
# Copy to .env.local and adjust. Never commit .env.local.

# --- Core ---
# Your nginx serves plain HTTP. The refresh cookie is only marked `Secure` when
# NODE_ENV=production, and a browser drops a Secure cookie over http://, so keep
# this at development until you put TLS in front. See docs/deployment-local.md.
NODE_ENV=development
PORT=4000

# Public origin INCLUDING the subpath the app is mounted at, without a trailing
# slash. Used for the links in verification and password-reset emails — the app
# routes them relative to its basename.
APP_WEB_URL=http://localhost:8080/ap/splitledger

# Everything is served from one origin, so no request is ever cross-origin and
# this value is not exercised. Set it to the origin you browse the app from.
CORS_ORIGIN=http://localhost:8080

# --- Database ---
# A Postgres on this machine, reached from inside the container. host.docker.internal
# resolves to the Docker host; the extra_hosts entry in the compose file provides it.
DATABASE_URL=postgres://splitledger:splitledger@host.docker.internal:55432/splitledger

# --- Auth ---
JWT_ACCESS_SECRET=local-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-refresh-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=sl_refresh
EMAIL_VERIFY_TTL=24h
PASSWORD_RESET_TTL=30m
MAX_TRANSACTION_MINOR=1000000000

# --- Email (Mailpit on this machine, if you run one) ---
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SplitLedger <no-reply@splitledger.local>
