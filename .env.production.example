# Production environment for the docker compose stack.
# Copy to .env.production and fill in real values. Never commit .env.production.

# --- Core ---
NODE_ENV=production
PORT=4000
# Public origin of the web app. Used for CORS and for links in emails.
CORS_ORIGIN=https://splitledger.example.com
APP_WEB_URL=https://splitledger.example.com

# --- Database (external Postgres 16; not part of this compose file) ---
# Managed/remote host, or host.docker.internal to reach Postgres on the Docker host.
DATABASE_URL=postgres://splitledger:change-me@host.docker.internal:5432/splitledger

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-value-min-16-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=sl_refresh
EMAIL_VERIFY_TTL=24h
PASSWORD_RESET_TTL=30m
MAX_TRANSACTION_MINOR=1000000000

# --- Email (real SMTP provider) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASS=change-me
MAIL_FROM=SplitLedger <no-reply@splitledger.example.com>
